# Copy to backend/.env and fill in. Never commit .env (real credentials).
# On Render, set these in the service's Environment settings instead.
# Run with `npm run dev` (nodemon, local) or `npm start` (node, what Render runs). Node 20+.

# Postgres connection string (Supabase → Project Settings → Database)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase Auth (Supabase → Project Settings → API); the server won't start without both
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Defaults to 3000; Render sets it itself
PORT=3000

# Confirmation-email link target. Optional locally (defaults to http://localhost:PORT/verified).
# Deployed: https://<your-api>.onrender.com/verified, also added to Supabase → Authentication → URL Configuration.
# EMAIL_REDIRECT_URL=
