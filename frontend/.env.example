# Copy to .env.local (gitignored) and set the backend URL for where you run the app.
# Defaults to http://localhost:3000 when unset (web build, iOS simulator).
#   Android emulator: http://10.0.2.2:3000
#   Physical phone:   http://<your computer's LAN IP>:3000  (same Wi-Fi)
# Restart `npx expo start` after changing it.
EXPO_PUBLIC_API_URL=http://localhost:3000
